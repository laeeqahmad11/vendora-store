rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Vendora's current upload service stores compressed data URLs inline in
    // Firestore. No production application flow depends on bucket objects.
    // Keep Storage fail-closed until an owned-path migration is implemented
    // and covered by rules tests.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
