rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function productPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }

    function couponPath(couponId) {
      return /databases/$(database)/documents/coupons/$(couponId);
    }

    function couponUsagePath(usageId) {
      return /databases/$(database)/documents/couponUsages/$(usageId);
    }

    function customerCouponUsagePath(couponId, customerId) {
      return /databases/$(database)/documents/customerCouponUsages/$(couponId + '_' + customerId);
    }

    function reviewPath(reviewId) {
      return /databases/$(database)/documents/reviews/$(reviewId);
    }

    function helpfulVotePath(reviewId, uid) {
      return /databases/$(database)/documents/reviews/$(reviewId)/helpfulVotes/$(uid);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function userDoc() {
      return get(userPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return currentUserExists()
        && (!userDoc().keys().hasAny(['suspended'])
            || userDoc().suspended == false);
    }

    function isAdmin() {
      return isActiveUser() && userDoc().role == 'admin';
    }

    function isMerchant() {
      return isActiveUser() && userDoc().role == 'merchant';
    }

    function isCustomer() {
      return isActiveUser() && userDoc().role == 'customer';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsStore(storeId) {
      return isMerchant()
        && storeId is string
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.ownerId == request.auth.uid
        && get(storePath(storeId)).data.status == 'approved';
    }

    function ownsStoreRecord(storeId) {
      return isActiveUser()
        && storeId is string
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.ownerId == request.auth.uid;
    }

    function ownsApplicationStore(storeId) {
      return isActiveUser() && ownsStoreRecord(storeId);
    }

    function storeIsOperational(storeId) {
      return storeId is string
        && exists(storePath(storeId))
        && get(storePath(storeId)).data.status == 'approved';
    }

    function validOrderStatus(status) {
      return status in [
        'pending', 'confirmed', 'packed', 'ready', 'dispatched',
        'delivered', 'completed', 'cancelled', 'returned', 'refund_requested'
      ];
    }

    function validSupportStatus(status) {
      return status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    function validSupportPriority(priority) {
      return priority in ['low', 'medium', 'high'];
    }

    function validCouponDocument(data) {
      return data.keys().hasAll([
          'code', 'type', 'value', 'usedCount', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeId', 'code', 'type', 'value', 'minOrderAmount',
          'maxDiscount', 'usageLimit', 'usedCount', 'perCustomerLimit',
          'startsAt', 'expiresAt', 'active', 'appliesTo', 'createdAt', 'updatedAt'
        ])
        && data.code is string
        && data.code.size() >= 3
        && data.code.size() <= 50
        && data.type in ['percentage', 'fixed', 'bogo', 'first_order']
        && data.value is number
        && data.value > 0
        && (data.type != 'percentage' || data.value <= 100)
        && data.usedCount is int
        && data.usedCount >= 0
        && data.active is bool
        && (!data.keys().hasAny(['storeId']) || data.storeId is string)
        && (!data.keys().hasAny(['minOrderAmount'])
            || (data.minOrderAmount is number && data.minOrderAmount > 0))
        && (!data.keys().hasAny(['maxDiscount'])
            || (data.maxDiscount is number && data.maxDiscount > 0))
        && (!data.keys().hasAny(['usageLimit'])
            || (data.usageLimit is int && data.usageLimit > 0))
        && (!data.keys().hasAny(['perCustomerLimit'])
            || (data.perCustomerLimit is int && data.perCustomerLimit > 0))
        && (!data.keys().hasAny(['startsAt']) || data.startsAt is number)
        && (!data.keys().hasAny(['expiresAt']) || data.expiresAt is number)
        && (!data.keys().hasAny(['startsAt', 'expiresAt'])
            || !data.keys().hasAll(['startsAt', 'expiresAt'])
            || data.expiresAt > data.startsAt)
        && (!data.keys().hasAny(['appliesTo']) || data.appliesTo is map);
    }

    function couponIsCurrentlyValid(coupon) {
      return coupon.active == true
        && (!coupon.keys().hasAny(['startsAt'])
            || request.time.toMillis() >= coupon.startsAt)
        && (!coupon.keys().hasAny(['expiresAt'])
            || request.time.toMillis() <= coupon.expiresAt)
        && (!coupon.keys().hasAny(['usageLimit'])
            || coupon.usedCount <= coupon.usageLimit);
    }

    function validCouponRedemption(couponId) {
      let counter = getAfter(
        customerCouponUsagePath(couponId, request.auth.uid)
      ).data;
      let usage = getAfter(couponUsagePath(counter.lastUsageId)).data;
      return isCustomer()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedCount', 'updatedAt'])
        && request.resource.data.usedCount == resource.data.usedCount + 1
        && request.resource.data.updatedAt == request.time
        && couponIsCurrentlyValid(request.resource.data)
        && counter.couponId == couponId
        && counter.customerId == request.auth.uid
        && usage.couponId == couponId
        && usage.customerId == request.auth.uid;
    }

    function validCouponDiscountBound(coupon) {
      return request.resource.data.discount <= request.resource.data.subtotal
        && (!coupon.keys().hasAny(['maxDiscount'])
            || request.resource.data.discount <= coupon.maxDiscount)
        && (coupon.type == 'bogo'
            || ((coupon.type == 'fixed' || coupon.type == 'first_order')
                && request.resource.data.discount <= coupon.value)
            || (coupon.type == 'percentage'
                && request.resource.data.discount
                   <= request.resource.data.subtotal * coupon.value / 100 + 0.011));
    }

    function validDiscountedOrder(orderId) {
      let previousCoupon = get(couponPath(request.resource.data.couponId)).data;
      let coupon = getAfter(couponPath(request.resource.data.couponId)).data;
      let usage = getAfter(couponUsagePath(request.resource.data.couponUsageId)).data;
      let counter = getAfter(
        customerCouponUsagePath(request.resource.data.couponId, request.auth.uid)
      ).data;
      return request.resource.data.couponId is string
        && request.resource.data.couponBasis is number
        && request.resource.data.couponBasis > 0
        && request.resource.data.couponCode is string
        && request.resource.data.couponUsageId is string
        && request.resource.data.discount > 0
        && request.resource.data.couponCode == coupon.code
        && couponIsCurrentlyValid(coupon)
        && (!coupon.keys().hasAny(['storeId'])
            || coupon.storeId == request.resource.data.storeId)
        && (!coupon.keys().hasAny(['minOrderAmount'])
            || request.resource.data.couponBasis >= coupon.minOrderAmount)
        && validCouponDiscountBound(coupon)
        && coupon.usedCount == previousCoupon.usedCount + 1
        && usage.couponId == request.resource.data.couponId
        && usage.couponCode == coupon.code
        && usage.customerId == request.auth.uid
        && orderId in usage.orderIds
        && counter.couponId == request.resource.data.couponId
        && counter.customerId == request.auth.uid
        && counter.lastUsageId == request.resource.data.couponUsageId
        && (!coupon.keys().hasAny(['perCustomerLimit'])
            || counter.count <= coupon.perCustomerLimit);
    }

    function validProfileFields(data) {
      return data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 50
        && data.role in ['admin', 'merchant', 'customer']
        && (!data.keys().hasAny(['photoURL'])
            || (data.photoURL is string && data.photoURL.size() <= 2048))
        && (!data.keys().hasAny(['phone'])
            || (data.phone is string && data.phone.size() <= 30))
        && (!data.keys().hasAny(['suspended']) || data.suspended is bool)
        && (!data.keys().hasAny(['emailVerified']) || data.emailVerified is bool)
        && (!data.keys().hasAny(['storeId']) || data.storeId is string);
    }

    function validCustomerProfileCreate(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasAll([
          'email', 'displayName', 'role', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'phone', 'role',
          'emailVerified', 'suspended', 'createdAt', 'updatedAt'
        ])
        && validProfileFields(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && (!request.resource.data.keys().hasAny(['suspended'])
            || request.resource.data.suspended == false)
        && (!request.resource.data.keys().hasAny(['emailVerified'])
            || request.resource.data.emailVerified
                 == (request.auth.token.email_verified == true))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'updatedAt'
        ])
        && validProfileFields(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }

    function validPublicStoreDocument(data) {
      return data.keys().hasAll([
          'ownerId', 'name', 'slug', 'description', 'status', 'verified',
          'rating', 'ratingCount', 'productCount', 'totalSales',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'name', 'slug', 'description', 'logoUrl', 'bannerUrl',
          'socialLinks', 'status', 'verified', 'rating', 'ratingCount',
          'productCount', 'totalSales', 'seo', 'businessHours',
          'shippingPolicy', 'shippingEnabled', 'shippingFee',
          'freeShippingThreshold', 'estimatedDeliveryDays',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && data.name is string
        && data.slug is string
        && data.description is string
        && data.status in ['pending', 'approved', 'rejected', 'suspended']
        && data.verified is bool
        && data.rating is number
        && data.ratingCount is int
        && data.productCount is int
        && data.totalSales is number;
    }

    function validMerchantApplication(data) {
      return data.keys().hasAll([
          'storeId', 'ownerId', 'email', 'phone', 'address', 'businessName',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeId', 'ownerId', 'email', 'phone', 'address', 'businessName',
          'businessDocumentUrl', 'status', 'rejectionReason',
          'createdAt', 'updatedAt'
        ])
        && data.storeId is string
        && data.ownerId is string
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 320
        && data.phone is string
        && data.phone.size() >= 6
        && data.phone.size() <= 40
        && data.address is string
        && data.address.size() >= 5
        && data.address.size() <= 500
        && data.businessName is string
        && data.businessName.size() >= 2
        && data.businessName.size() <= 200
        && (!data.keys().hasAny(['businessDocumentUrl'])
            || (data.businessDocumentUrl is string
                && data.businessDocumentUrl.size() <= 1048576))
        && (!data.keys().hasAny(['rejectionReason'])
            || (data.rejectionReason is string
                && data.rejectionReason.size() <= 2000))
        && data.status in ['pending', 'approved', 'rejected', 'suspended'];
    }

    function validAddress(data) {
      return data.keys().hasAll([
          'label', 'fullName', 'phone', 'line1', 'city', 'province',
          'postalCode', 'country', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'label', 'fullName', 'phone', 'line1', 'line2', 'city',
          'province', 'postalCode', 'country', 'isDefault',
          'createdAt', 'updatedAt'
        ])
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 50
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && data.phone is string
        && data.phone.size() >= 6
        && data.phone.size() <= 30
        && data.line1 is string
        && data.line1.size() >= 3
        && data.line1.size() <= 200
        && (!data.keys().hasAny(['line2'])
            || (data.line2 is string && data.line2.size() <= 200))
        && data.city is string
        && data.city.size() >= 2
        && data.city.size() <= 100
        && data.province is string
        && data.province.size() >= 2
        && data.province.size() <= 100
        && data.postalCode is string
        && data.postalCode.size() >= 2
        && data.postalCode.size() <= 20
        && data.country is string
        && data.country.size() >= 2
        && data.country.size() <= 100
        && (!data.keys().hasAny(['isDefault']) || data.isDefault is bool);
    }

    function validAddressCreate() {
      return validAddress(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validAddressUpdate() {
      return validAddress(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'label', 'fullName', 'phone', 'line1', 'line2', 'city',
          'province', 'postalCode', 'country', 'isDefault', 'updatedAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validProductAggregate(data) {
      return data.ratingCount is int
        && data.ratingCount >= 0
        && data.ratingSum is int
        && data.ratingSum >= 0
        && data.ratingSum <= data.ratingCount * 5
        && ((data.ratingCount == 0
              && data.ratingSum == 0
              && data.rating == 0)
            || (data.ratingCount > 0
              && data.rating * data.ratingCount == data.ratingSum));
    }

    function aggregateFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'rating', 'ratingCount', 'ratingSum', 'ratingReviewId',
        'ratingReviewVersion'
      ]);
    }

    function productMaterialFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'name', 'description', 'images', 'videoUrl',
        'price', 'compareAtPrice', 'currency', 'sku', 'barcode',
        'minOrderQty', 'maxOrderQty',
        'categoryId', 'subcategoryId', 'brandId', 'tags', 'collectionIds',
        'variantOptions', 'variants', 'specifications',
        'weight', 'dimensions', 'warranty', 'returnPolicy', 'shippingInfo',
        'relatedProductIds', 'seo', 'flashSale'
      ]);
    }

    function merchantProductFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'description', 'images', 'videoUrl',
        'price', 'compareAtPrice', 'currency', 'sku', 'barcode',
        'stock', 'lowStockThreshold', 'minOrderQty', 'maxOrderQty',
        'categoryId', 'subcategoryId', 'brandId', 'tags', 'collectionIds',
        'variantOptions', 'variants', 'specifications',
        'weight', 'dimensions', 'warranty', 'returnPolicy', 'shippingInfo',
        'relatedProductIds', 'seo', 'flashSale',
        'status', 'publiclyVisible', 'rejectionReason', 'updatedAt'
      ]);
    }

    function validMerchantProductStateTransition() {
      return request.resource.data.status == resource.data.status
        ? (request.resource.data.publiclyVisible == resource.data.publiclyVisible
          && request.resource.data.get('rejectionReason', '')
               == resource.data.get('rejectionReason', '')
          && (request.resource.data.status == 'approved'
              ? !productMaterialFieldsChanged()
              : request.resource.data.publiclyVisible == false))
        : request.resource.data.status == 'pending'
          ? (resource.data.status in ['draft', 'rejected', 'approved']
            && request.resource.data.publiclyVisible == false
            && request.resource.data.rejectionReason == '')
          : request.resource.data.status == 'archived'
            ? (resource.data.status != 'archived'
              && request.resource.data.publiclyVisible == false
              && request.resource.data.get('rejectionReason', '')
                   == resource.data.get('rejectionReason', ''))
            : request.resource.data.status == 'draft'
              ? (resource.data.status == 'archived'
                && request.resource.data.publiclyVisible == false
                && request.resource.data.get('rejectionReason', '')
                     == resource.data.get('rejectionReason', ''))
              : false;
    }

    function validMerchantProductUpdate() {
      return isMerchant()
        && resource.data.merchantId == request.auth.uid
        && request.resource.data.merchantId == resource.data.merchantId
        && request.resource.data.storeId == resource.data.storeId
        && ownsStore(resource.data.storeId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && merchantProductFieldsOnly()
        && aggregateFieldsUnchanged()
        && validMerchantProductStateTransition();
    }

    function validProductAggregateTransition(productId) {
      let reviewId = request.resource.data.ratingReviewId;
      let existedBefore = exists(reviewPath(reviewId));
      let existsAfterWrite = existsAfter(reviewPath(reviewId));
      let contributedBefore = existedBefore
        && get(reviewPath(reviewId)).data.productId == productId
        && get(reviewPath(reviewId)).data.status == 'approved';
      let contributesAfter = existsAfterWrite
        && getAfter(reviewPath(reviewId)).data.productId == productId
        && getAfter(reviewPath(reviewId)).data.status == 'approved';
      return isActiveUser()
        && reviewId is string
        && validProductAggregate(resource.data)
        && validProductAggregate(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rating', 'ratingCount', 'ratingSum', 'ratingReviewId',
          'ratingReviewVersion', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.ratingReviewVersion
             == (contributesAfter
                  ? getAfter(reviewPath(reviewId)).data.aggregateVersion
                  : get(reviewPath(reviewId)).data.aggregateVersion + 1)
        && request.resource.data.ratingSum
             == resource.data.ratingSum
                - (contributedBefore ? get(reviewPath(reviewId)).data.rating : 0)
                + (contributesAfter ? getAfter(reviewPath(reviewId)).data.rating : 0)
        && request.resource.data.ratingCount
             == resource.data.ratingCount
                - (contributedBefore ? 1 : 0)
                + (contributesAfter ? 1 : 0);
    }

    function aggregatePointerMatches(reviewId, productId, version) {
      return getAfter(productPath(productId)).data.ratingReviewId == reviewId
        && getAfter(productPath(productId)).data.ratingReviewVersion == version;
    }

    function validReviewCreate(reviewId) {
      return request.resource.data.keys().hasAll([
          'productId', 'storeId', 'customerId', 'customerName', 'rating',
          'comment', 'status', 'helpfulCount', 'aggregateVersion',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'storeId', 'customerId', 'customerName', 'rating',
          'title', 'comment', 'images', 'status', 'helpfulCount',
          'aggregateVersion', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.productId is string
        && request.resource.data.storeId is string
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && (!request.resource.data.keys().hasAny(['title'])
            || (request.resource.data.title is string
                && request.resource.data.title.size() > 0
                && request.resource.data.title.size() <= 100))
        && (!request.resource.data.keys().hasAny(['images'])
            || (request.resource.data.images is list
                && request.resource.data.images.size() <= 4))
        && request.resource.data.status == 'approved'
        && request.resource.data.helpfulCount == 0
        && request.resource.data.aggregateVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(productPath(request.resource.data.productId))
        && get(productPath(request.resource.data.productId)).data.status == 'approved'
        && get(productPath(request.resource.data.productId)).data.storeId
             == request.resource.data.storeId
        && aggregatePointerMatches(
             reviewId,
             request.resource.data.productId,
             1
           );
    }

    function validReviewReply(reply) {
      return reply is map
        && reply.keys().hasAll(['text', 'at'])
        && reply.keys().hasOnly(['text', 'at'])
        && reply.text is string
        && reply.text.size() > 0
        && reply.text.size() <= 2000
        && reply.at is int;
    }

    function validMerchantReviewUpdate(reviewId) {
      return isActiveUser()
        && ownsStore(resource.data.storeId)
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'aggregateVersion', 'updatedAt'
            ])
            && validReviewStatusUpdate(reviewId))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reply', 'updatedAt'
            ])
            && validReviewReply(request.resource.data.reply))
        );
    }

    function validReviewInteraction(reviewId) {
      return isActiveUser()
        && resource.data.status == 'approved'
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'helpfulCount', 'updatedAt'
            ])
            && request.resource.data.helpfulCount is int
            && request.resource.data.helpfulCount == resource.data.helpfulCount + 1
            && !exists(helpfulVotePath(reviewId, request.auth.uid))
            && existsAfter(helpfulVotePath(reviewId, request.auth.uid))
            && getAfter(helpfulVotePath(reviewId, request.auth.uid)).data.userId
                 == request.auth.uid
            && getAfter(helpfulVotePath(reviewId, request.auth.uid)).data.reviewId
                 == reviewId)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reported', 'updatedAt'
            ])
            && (!resource.data.keys().hasAny(['reported'])
                || resource.data.reported != true)
            && request.resource.data.reported == true)
        );
    }

    function validReviewStatusUpdate(reviewId) {
      return request.resource.data.status != resource.data.status
        && request.resource.data.status in ['approved', 'hidden', 'rejected']
        && ((resource.data.status != 'approved'
              && request.resource.data.status != 'approved'
              && request.resource.data.aggregateVersion == resource.data.aggregateVersion)
            || (request.resource.data.aggregateVersion == resource.data.aggregateVersion + 1
              && aggregatePointerMatches(
                   reviewId,
                   resource.data.productId,
                   request.resource.data.aggregateVersion
                 )));
    }

    function validAdminReviewUpdate(reviewId) {
      return isAdmin()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'aggregateVersion', 'updatedAt'
        ])
        && validReviewStatusUpdate(reviewId);
    }

    function validReviewDelete(reviewId) {
      return resource.data.status != 'approved'
        || aggregatePointerMatches(
             reviewId,
             resource.data.productId,
             resource.data.aggregateVersion + 1
           );
    }

    // -------------------------------------------------------------- users
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      allow create: if validCustomerProfileCreate(uid);

      // Self-service updates are limited to normal profile fields.
      // Email/verification, role, suspended, storeId and createdAt are managed
      // by Firebase Auth or the platform, never by customer profile writes.
      allow update: if isAdmin()
        || (isActiveUser() && isSelf(uid) && validSelfProfileUpdate());

      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isSelf(uid);
        allow create: if isActiveUser() && isSelf(uid) && validAddressCreate();
        allow update: if isActiveUser() && isSelf(uid) && validAddressUpdate();
        allow delete: if isActiveUser() && isSelf(uid);
      }
    }

    // ------------------------------------------------------------- stores
    match /stores/{storeId} {
      // Public reads return the entire document, so approved records must
      // conform to the public-only schema. Public collection queries use the
      // trusted publicStores projection because queries cannot prove allowlists.
      allow get: if (resource.data.status == 'approved'
            && validPublicStoreDocument(resource.data))
        || isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isCustomer()
        && request.resource.data.ownerId == request.auth.uid
        && validPublicStoreDocument(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && request.resource.data.rating == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.productCount == 0
        && request.resource.data.totalSales == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(
             /databases/$(database)/documents/merchantApplications/$(storeId)
           )
        && getAfter(
             /databases/$(database)/documents/merchantApplications/$(storeId)
           ).data.ownerId == request.auth.uid;

      // Active approved merchants can edit public profile/shipping fields only.
      allow update: if (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'verified', 'rating', 'ratingCount', 'productCount',
              'totalSales', 'updatedAt'
            ])
            && validPublicStoreDocument(request.resource.data))
        || (ownsStore(storeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'slug', 'description', 'logoUrl', 'bannerUrl',
              'socialLinks', 'seo', 'businessHours',
              'shippingPolicy', 'shippingEnabled', 'shippingFee',
              'freeShippingThreshold', 'estimatedDeliveryDays', 'updatedAt'
            ])
            && validPublicStoreDocument(request.resource.data))
        || (ownsApplicationStore(storeId)
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'logoUrl', 'status', 'updatedAt'
            ])
            && validPublicStoreDocument(request.resource.data)
            && getAfter(
                 /databases/$(database)/documents/merchantApplications/$(storeId)
               ).data.status == 'pending');

      allow delete: if isAdmin();
    }

    // Trusted, public-only store projection. Client writes are always denied;
    // Cloud Functions and migration tooling populate this collection.
    match /publicStores/{storeId} {
      allow read: if resource.data.status == 'approved';
      allow write: if false;
    }

    // ------------------------------------------- private merchant applications
    match /merchantApplications/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      allow create: if isCustomer()
        && applicationId == request.resource.data.storeId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validMerchantApplication(request.resource.data)
        && existsAfter(storePath(request.resource.data.storeId))
        && getAfter(storePath(request.resource.data.storeId)).data.ownerId
             == request.auth.uid
        && getAfter(storePath(request.resource.data.storeId)).data.status
             == 'pending';

      allow update: if (isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'rejectionReason', 'updatedAt'
            ])
            && validMerchantApplication(request.resource.data))
        || (ownsStore(resource.data.storeId)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.storeId == resource.data.storeId
            && request.resource.data.status == resource.data.status
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'email', 'phone', 'address', 'businessName',
              'businessDocumentUrl', 'updatedAt'
            ])
            && validMerchantApplication(request.resource.data))
        || (ownsApplicationStore(resource.data.storeId)
            && resource.data.status == 'rejected'
            && request.resource.data.status == 'pending'
            && request.resource.data.rejectionReason == ''
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.storeId == resource.data.storeId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'email', 'phone', 'address', 'businessName',
              'businessDocumentUrl', 'status', 'rejectionReason', 'updatedAt'
            ])
            && validMerchantApplication(request.resource.data)
            && getAfter(storePath(resource.data.storeId)).data.status == 'pending');

      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------- products
    match /products/{productId} {
      allow read: if (resource.data.status == 'approved'
            && resource.data.publiclyVisible == true)
        || isAdmin()
        || (isMerchant() && ownsStore(resource.data.storeId));

      allow create: if isMerchant()
        && request.resource.data.merchantId == request.auth.uid
        && ownsStore(request.resource.data.storeId)
        && request.resource.data.status in ['draft', 'pending']
        && request.resource.data.publiclyVisible == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.keys().hasAny([
          'publishedAt', 'ratingReviewId', 'ratingReviewVersion'
        ])
        && (!request.resource.data.keys().hasAny(['rejectionReason'])
            || request.resource.data.rejectionReason == '')
        && (!request.resource.data.keys().hasAny(['featured'])
            || request.resource.data.featured == false)
        && (!request.resource.data.keys().hasAny(['trending'])
            || request.resource.data.trending == false)
        && (!request.resource.data.keys().hasAny(['recommended'])
            || request.resource.data.recommended == false)
        && request.resource.data.rating == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.soldCount == 0
        && request.resource.data.viewCount == 0;

      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'rating', 'ratingCount', 'ratingSum'
            ])
            && request.resource.data.keys().hasAll([
              'ratingReviewId', 'ratingReviewVersion'
            ])
            && validProductAggregateTransition(productId))

        || (isAdmin()
            && aggregateFieldsUnchanged()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'status', 'rejectionReason', 'publishedAt', 'publiclyVisible'
            ])
            && ((request.resource.data.status == 'approved'
                  && request.resource.data.publiclyVisible
                       == resource.data.publiclyVisible)
                || (request.resource.data.status != 'approved'
                  && request.resource.data.publiclyVisible == false)))

        // Merchant edits are field-limited and follow the moderation state
        // machine. Material changes to an approved listing must atomically
        // enter pending review and become non-public.
        || validMerchantProductUpdate()

        // Current client-side view counter.
        || (isActiveUser()
            && resource.data.status == 'approved'
            && resource.data.publiclyVisible == true
            && storeIsOperational(resource.data.storeId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['viewCount', 'updatedAt'])
            && request.resource.data.viewCount == resource.data.viewCount + 1);

      allow delete: if isAdmin()
        || (isMerchant()
            && resource.data.merchantId == request.auth.uid
            && ownsStore(resource.data.storeId));
    }

    // ------------------------------------------------------------- orders
    match /checkoutRequests/{requestId} {
      // Idempotency records contain backend coordination state and are never
      // readable or writable by browser clients.
      allow read, write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isMerchant() && ownsStore(resource.data.storeId));

      // Order creation is server-only. Admin SDK writes from the trusted
      // checkout function bypass rules; no browser identity may create one.
      allow create: if false;

      // Every order mutation is server-only. Trusted Functions use the Admin
      // SDK and enforce the state machine transactionally.
      allow update: if false;

      allow delete: if false;
    }

    // ------------------------------------------------ catalog (admin-owned)
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /collections/{id} {
      allow read: if true;
      // Merchants manage their own store collections; admin manages global
      allow create: if isAdmin()
        || (isMerchant() && request.resource.data.storeId is string && ownsStore(request.resource.data.storeId));
      allow update, delete: if isAdmin()
        || (isMerchant() && resource.data.storeId is string && ownsStore(resource.data.storeId));
    }

    // ------------------------------------------------------------- reviews
    match /reviews/{id} {
      // Only approved reviews are public. Authors, owning stores, and admins
      // retain the non-public visibility used by their existing dashboards.
      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (isMerchant() && ownsStore(resource.data.storeId));

      // The storefront publishes customer reviews immediately. Identity,
      // moderation, reply, verification, counters, and timestamps cannot be
      // supplied outside that exact client workflow.
      allow create: if isCustomer() && validReviewCreate(id);

      // There is no author editing workflow. Store owners may only moderate
      // or reply, while signed-in storefront users retain helpful/report.
      allow update: if validAdminReviewUpdate(id)
        || validMerchantReviewUpdate(id)
        || validReviewInteraction(id);

      // Review deletion is an admin-only moderation action.
      allow delete: if isAdmin() && validReviewDelete(id);

      match /helpfulVotes/{uid} {
        allow read: if isSelf(uid);

        allow create: if isActiveUser() && isSelf(uid)
          && request.resource.data.keys().hasAll([
            'reviewId', 'userId', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'reviewId', 'userId', 'createdAt'
          ])
          && request.resource.data.reviewId == id
          && request.resource.data.userId == uid
          && request.resource.data.createdAt == request.time
          && exists(reviewPath(id))
          && get(reviewPath(id)).data.status == 'approved'
          && getAfter(reviewPath(id)).data.helpfulCount
               == get(reviewPath(id)).data.helpfulCount + 1;

        // Helpful is intentionally a one-way action in the current product UI.
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------- coupons & promotions
    match /coupons/{id} {
      allow read: if true; // codes validated client-side at checkout
      allow create: if validCouponDocument(request.resource.data)
        && request.resource.data.usedCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (isAdmin()
            || (isMerchant()
                && request.resource.data.storeId is string
                && ownsStore(request.resource.data.storeId)));
      allow update: if (isAdmin()
            && validCouponDocument(request.resource.data)
            && request.resource.data.createdAt == resource.data.createdAt)
        || (isMerchant()
            && resource.data.storeId is string
            && ownsStore(resource.data.storeId)
            && request.resource.data.storeId == resource.data.storeId
            && request.resource.data.usedCount == resource.data.usedCount
            && request.resource.data.createdAt == resource.data.createdAt
            && validCouponDocument(request.resource.data));
      allow delete: if isAdmin()
        || (isMerchant() && resource.data.storeId is string && ownsStore(resource.data.storeId));
    }
    match /promotions/{id} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && ownsStore(request.resource.data.storeId));
      allow update, delete: if isAdmin()
        || (isMerchant() && resource.data.storeId is string && ownsStore(resource.data.storeId));
    }


    // ---------------------------------------------------- coupon usages
    match /couponUsages/{usageId} {
      // Admins can read every usage record.
      // Customers can read only their own coupon usage.
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      // Usage history is written only by the trusted checkout backend.
      allow create: if false;

      // Usage history is immutable from the client.
      allow update, delete: if false;
    }

    match /customerCouponUsages/{counterId} {
      allow read: if isAdmin()
        || (signedIn()
            && (!exists(
                  /databases/$(database)/documents/customerCouponUsages/$(counterId)
                )
                || resource.data.customerId == request.auth.uid));

      allow create, update: if false;

      allow delete: if false;
    }

    // -------------------------------------------------------- notifications
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      // Business-event notifications are created only by trusted backend code.
      // Admin SDK writes bypass rules; no browser role may forge one.
      allow create: if false;

      // An active recipient can change only their own boolean read state.
      allow update: if isActiveUser()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.read is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read', 'updatedAt']);

      allow delete: if isActiveUser() && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------------ cms
    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------- support
    match /supportTickets/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isActiveUser()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'open'
        && validSupportPriority(request.resource.data.priority)
        && request.resource.data.messages is list
        && request.resource.data.messages.size() == 1
        && request.resource.data.messages[0].senderId == request.auth.uid;

      allow update: if
        // Admin can reply and change status/priority.
        (isAdmin()
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'priority', 'messages', 'updatedAt'
          ])
          && validSupportStatus(request.resource.data.status)
          && validSupportPriority(request.resource.data.priority)
          && request.resource.data.messages is list
          && (
            request.resource.data.messages == resource.data.messages
            || (
              request.resource.data.messages.size()
                == resource.data.messages.size() + 1
              && request.resource.data.messages[
                   request.resource.data.messages.size() - 1
                 ].senderId == request.auth.uid
            )
          ))

        // Customer can append exactly one message and cannot change metadata.
        || (isActiveUser()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.status == resource.data.status
          && request.resource.data.priority == resource.data.priority
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['messages', 'updatedAt'])
          && request.resource.data.messages is list
          && request.resource.data.messages.size()
             == resource.data.messages.size() + 1
          && request.resource.data.messages[
               request.resource.data.messages.size() - 1
             ].senderId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- logging
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isActiveUser()
        && currentUserExists()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorRole == userDoc().role
        && !request.resource.data.action.matches('order\\..*');
      allow update, delete: if false;
    }

    match /inventoryLogs/{id} {
      allow read: if isAdmin()
        || (signedIn() && ownsStore(resource.data.storeId));
      allow create: if isActiveUser()
        && (isAdmin() || ownsStore(request.resource.data.storeId))
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------- newsletter
    match /newsletter/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
