{
  "name": "vendora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "seed": "node scripts/seed.mjs",
    "test:e2e": "node scripts/e2e/run-tests.mjs public",
    "e2e:emulators:install": "node --use-system-ca scripts/e2e/install-java.mjs && node --use-system-ca scripts/e2e/install-emulators.mjs",
    "e2e:emulators": "node --use-system-ca scripts/e2e/firebase-cli-local.mjs emulators:start --project demo-vendora-e2e --only auth,firestore,functions,storage",
    "e2e:seed": "node scripts/e2e/seed-emulators.mjs",
    "e2e:reset": "node scripts/e2e/seed-emulators.mjs --reset-only",
    "test:e2e:auth": "node --use-system-ca scripts/e2e/run-tests.mjs authenticated",
    "test:e2e:reviews": "node --use-system-ca scripts/e2e/run-tests.mjs authenticated --project=reviews-ratings",
    "test:e2e:account": "node --use-system-ca scripts/e2e/run-tests.mjs authenticated --project=customer-account",
    "test:security:account": "node --use-system-ca scripts/e2e/firebase-cli-local.mjs emulators:exec --project demo-vendora-e2e --only firestore \"node --test tests/security/customer-account.rules.node.mjs\"",
    "test:security:reviews": "node --use-system-ca scripts/e2e/firebase-cli-local.mjs emulators:exec --project demo-vendora-e2e --only firestore \"node --test tests/security/reviews.rules.node.mjs\"",
    "test:security:discounts": "node --use-system-ca scripts/e2e/firebase-cli-local.mjs emulators:exec --project demo-vendora-e2e --only firestore \"node --test tests/security/discounts.rules.node.mjs\"",
    "test:security:checkout": "node --use-system-ca scripts/e2e/firebase-cli-local.mjs emulators:exec --project demo-vendora-e2e --only auth,firestore,functions \"node --test tests/security/checkout-backend.node.mjs\"",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-radio-group": "^1.4.2",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "firebase": "^12.15.0",
    "firebase-functions": "^7.0.0",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "15.26.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
